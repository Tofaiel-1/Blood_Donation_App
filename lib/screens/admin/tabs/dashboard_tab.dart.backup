  /// Generate Users Report
  Future<void> _generateUsersReport(BuildContext context) async {
    try {
      final snapshot = await FirebaseFirestore.instance
          .collection('users')
          .where('role', isEqualTo: 'user')
          .get();

      final report = StringBuffer();
      report.writeln('USERS REPORT');
      report.writeln('Generated: ${DateTime.now()}');
      report.writeln('Total Users: ${snapshot.docs.length}');
      report.writeln('\n${'=' * 50}\n');

      for (var doc in snapshot.docs) {
        final data = doc.data();
        report.writeln('Name: ${data['name'] ?? 'N/A'}');
        report.writeln('Email: ${data['email'] ?? 'N/A'}');
        report.writeln('Blood Type: ${data['bloodType'] ?? 'N/A'}');
        report.writeln('Phone: ${data['phone'] ?? 'N/A'}');
        report.writeln('Total Donations: ${data['totalDonations'] ?? 0}');
        report.writeln('-' * 50);
      }

      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              'Users report generated (${snapshot.docs.length} users)',
            ),
            action: SnackBarAction(
              label: 'View',
              onPressed: () {
                showDialog(
                  context: context,
                  builder: (context) => AlertDialog(
                    title: const Text('Users Report'),
                    content: SingleChildScrollView(
                      child: Text(report.toString()),
                    ),
                    actions: [
                      TextButton(
                        onPressed: () => Navigator.pop(context),
                        child: const Text('Close'),
                      ),
                    ],
                  ),
                );
              },
            ),
          ),
        );
      }
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    }
  }

  /// Generate Donations Report
  Future<void> _generateDonationsReport(BuildContext context) async {
    try {
      final snapshot = await FirebaseFirestore.instance
          .collection('donations')
          .get();

      final completed = snapshot.docs
          .where((d) => (d.data())['status'] == 'completed')
          .length;
      final pending = snapshot.docs
          .where((d) => (d.data())['status'] == 'pending')
          .length;

      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              'Donations: Total ${snapshot.docs.length}, Completed $completed, Pending $pending',
            ),
          ),
        );
      }
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    }
  }

