  /// Export Full Data
  Future<void> _exportFullData(BuildContext context) async {
    try {
      final users = await FirebaseFirestore.instance
          .collection('users')
          .where('role', isEqualTo: 'user')
          .get();
      final donations = await FirebaseFirestore.instance
          .collection('donations')
          .get();
      final events = await FirebaseFirestore.instance
          .collection('events')
          .get();

      final report = StringBuffer();
      report.writeln('===== BLOOD DONATION APP - FULL DATA EXPORT =====');
      report.writeln('Generated: ${DateTime.now()}');
      report.writeln('');
      report.writeln('--- STATISTICS ---');
      report.writeln('Total Users: ${users.docs.length}');
      report.writeln('Total Donations: ${donations.docs.length}');
      report.writeln('Total Events: ${events.docs.length}');
      report.writeln('');
      report.writeln('--- USERS DATA ---');
      for (var doc in users.docs) {
        final data = doc.data();
        report.writeln(
          '${data['name']} (${data['bloodType']}) - ${data['email']}',
        );
      }
      report.writeln('');
      report.writeln('--- DONATIONS DATA ---');
      for (var doc in donations.docs) {
        final data = doc.data();
        report.writeln(
          '${data['bloodType']} - ${data['units']} units - ${data['status']}',
        );
      }
      report.writeln('');
      report.writeln('--- EVENTS DATA ---');
      for (var doc in events.docs) {
        final data = doc.data();
        report.writeln(
          '${data['title']} - ${data['location']} - ${data['status']}',
        );
      }

      if (context.mounted) {
        Navigator.pop(context);
        showDialog(
          context: context,
          builder: (context) => AlertDialog(
            title: const Text('Full Data Export'),
            content: SizedBox(
              width: double.maxFinite,
              height: 400,
              child: SingleChildScrollView(
                child: SelectableText(report.toString()),
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context),
                child: const Text('Close'),
              ),
            ],
          ),
        );
      }
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    }
  }
}
