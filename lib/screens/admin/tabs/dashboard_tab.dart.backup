  /// Export Users
  Future<void> _exportUsers(BuildContext context) async {
    try {
      final snapshot = await FirebaseFirestore.instance
          .collection('users')
          .where('role', isEqualTo: 'user')
          .get();

      final csvData = StringBuffer();
      csvData.writeln('Name,Email,Blood Type,Phone,Total Donations,Created At');

      for (var doc in snapshot.docs) {
        final data = doc.data();
        csvData.writeln(
          '${data['name']},${data['email']},${data['bloodType']},'
          '${data['phone']},${data['totalDonations'] ?? 0},'
          '${_formatDate(data['createdAt'])}',
        );
      }

      if (context.mounted) {
        Navigator.pop(context);
        showDialog(
          context: context,
          builder: (context) => AlertDialog(
            title: const Text('Users Data Export'),
            content: SingleChildScrollView(
              child: SelectableText(csvData.toString()),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context),
                child: const Text('Close'),
              ),
            ],
          ),
        );
      }
    } catch (e) {
      if (context.mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    }
  }

